#!/bin/sh
# my-linux-update — update OS packages on a Linux host, multi-distro
#
# Supports package managers: dnf, yum, apt-get, zypper, apk
# Written in POSIX sh (no bashisms). Runs on the target Linux host.
#
# Author: Tormen <tormen@mail.ch>
# License: do whatever
#
# Config search order (first hit wins):
#   1. $LINKS/default/my-linux-update.conf  (if $LINKS is set)
#   2. ~/.my-linux-update.conf
#   3. /etc/my-linux-update.conf
#   4. /usr/local/etc/my-linux-update.conf
#
# Exit codes:
#   0   success, no reboot needed
#  10   success, reboot needed (and --reboot not given)
#   1   error
#   2   bad usage

set -eu

VERSION="1.0.0"
SCRIPT_NAME="my-linux-update"

# ---------------- defaults (overridable in config file) ----------------
LOG_FILE="/var/log/${SCRIPT_NAME}.log"
AUTO_REMOVE=1
DRY_RUN=0
REBOOT_AFTER=0
EXTRA_DNF_OPTS=""
EXTRA_APT_OPTS=""
EXTRA_ZYPPER_OPTS=""
POST_UPDATE_HOOK=""

# ---------------- runtime state ----------------
DEBUG=0
DEBUG_LOG=""
CONFIG=""

# ---------------- helpers ----------------

ts() { date '+%Y-%m-%d %H:%M:%S'; }

log() {
    _msg="$*"
    printf '%s  %s\n' "$(ts)" "$_msg" >&2
    if [ -n "${LOG_FILE:-}" ]; then
        printf '%s  %s\n' "$(ts)" "$_msg" >> "$LOG_FILE" 2>/dev/null || true
    fi
    if [ "$DEBUG" = "1" ] && [ -n "$DEBUG_LOG" ]; then
        printf '%s  %s\n' "$(ts)" "$_msg" >> "$DEBUG_LOG" 2>/dev/null || true
    fi
}

dbg() {
    [ "$DEBUG" = "1" ] || return 0
    log "DEBUG: $*"
}

die() {
    log "ERROR: $*"
    exit 1
}

run() {
    log "RUN: $*"
    if [ "$DRY_RUN" = "1" ]; then
        log "  (dry-run: skipped)"
        return 0
    fi
    "$@"
}

usage() {
    cat <<EOF
$SCRIPT_NAME $VERSION — update Linux OS packages (multi-distro)

Usage:
  $SCRIPT_NAME [options]

Options:
  --config PATH               use config file at PATH; if PATH is '-',
                              print the resolved config path and exit
  --create-config [PATH]      write default config to PATH; if no PATH,
                              print default config to stdout (never writes
                              without an explicit PATH argument)
  -D, --debug [PATH]          enable debug logging; optional PATH for log file
  -n, --dry-run               show what would be done, change nothing
  -r, --reboot                reboot at end if a reboot is needed
  -h, --help                  this help
  -V, --version               print version

Config search order (first hit wins):
  1. \$LINKS/default/${SCRIPT_NAME}.conf
  2. ~/.${SCRIPT_NAME}.conf
  3. /etc/${SCRIPT_NAME}.conf
  4. /usr/local/etc/${SCRIPT_NAME}.conf

Exit codes:
   0  success, no reboot needed
  10  success, reboot needed (and --reboot not given)
   1  error
   2  bad usage
EOF
}

print_default_config() {
    cat <<'EOF'
# my-linux-update.conf — sourced as POSIX sh, so use shell syntax
#
# Logging
LOG_FILE="/var/log/my-linux-update.log"

# Run package-manager autoremove step after updates (1=yes, 0=no)
AUTO_REMOVE=1

# Default to dry-run (1=yes, 0=no). CLI --dry-run overrides this.
DRY_RUN=0

# Reboot automatically at the end if a reboot is needed (1=yes, 0=no).
# CLI --reboot overrides this.
REBOOT_AFTER=0

# Extra options passed verbatim to the package manager.
EXTRA_DNF_OPTS=""
EXTRA_APT_OPTS=""
EXTRA_ZYPPER_OPTS=""

# Optional hook: absolute path to a script that will be run AFTER a
# successful update and BEFORE the reboot decision. Receives the
# package manager name as its first argument.
POST_UPDATE_HOOK=""
EOF
}

resolve_config() {
    if [ -n "$CONFIG" ]; then
        echo "$CONFIG"
        return 0
    fi
    # 1. $LINKS/default/
    if [ -n "${LINKS:-}" ] && [ -r "$LINKS/default/${SCRIPT_NAME}.conf" ]; then
        echo "$LINKS/default/${SCRIPT_NAME}.conf"
        return 0
    fi
    # 2. ~/
    if [ -r "$HOME/.${SCRIPT_NAME}.conf" ]; then
        echo "$HOME/.${SCRIPT_NAME}.conf"
        return 0
    fi
    # 3. /etc/
    if [ -r "/etc/${SCRIPT_NAME}.conf" ]; then
        echo "/etc/${SCRIPT_NAME}.conf"
        return 0
    fi
    # 4. /usr/local/etc/
    if [ -r "/usr/local/etc/${SCRIPT_NAME}.conf" ]; then
        echo "/usr/local/etc/${SCRIPT_NAME}.conf"
        return 0
    fi
    return 1
}

load_config() {
    _cfg="$(resolve_config 2>/dev/null || true)"
    if [ -n "$_cfg" ] && [ -r "$_cfg" ]; then
        dbg "loading config: $_cfg"
        # shellcheck disable=SC1090
        . "$_cfg"
    else
        dbg "no config file found; using built-in defaults"
    fi
}

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        die "must run as root (got UID $(id -u))"
    fi
}

detect_pkgmgr() {
    if   command -v dnf       >/dev/null 2>&1; then echo dnf
    elif command -v yum       >/dev/null 2>&1; then echo yum
    elif command -v apt-get   >/dev/null 2>&1; then echo apt
    elif command -v zypper    >/dev/null 2>&1; then echo zypper
    elif command -v apk       >/dev/null 2>&1; then echo apk
    else return 1
    fi
}

distro_id() {
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        ( . /etc/os-release; printf '%s %s\n' "${ID:-unknown}" "${VERSION_ID:-?}" )
    else
        echo "unknown ?"
    fi
}

# ---------------- per-pkgmgr update routines ----------------

update_dnf() {
    # shellcheck disable=SC2086
    run dnf -y $EXTRA_DNF_OPTS upgrade --refresh
    if [ "$AUTO_REMOVE" = "1" ]; then
        run dnf -y autoremove
    fi
    run dnf -y clean packages
}

update_yum() {
    run yum -y update
    if [ "$AUTO_REMOVE" = "1" ]; then
        run yum -y autoremove || true
    fi
    run yum -y clean packages
}

update_apt() {
    export DEBIAN_FRONTEND=noninteractive
    run apt-get update
    # shellcheck disable=SC2086
    run apt-get -y \
        -o Dpkg::Options::=--force-confdef \
        -o Dpkg::Options::=--force-confold \
        $EXTRA_APT_OPTS \
        dist-upgrade
    if [ "$AUTO_REMOVE" = "1" ]; then
        run apt-get -y autoremove --purge
    fi
    run apt-get -y autoclean
}

update_zypper() {
    # shellcheck disable=SC2086
    run zypper --non-interactive $EXTRA_ZYPPER_OPTS refresh
    # shellcheck disable=SC2086
    run zypper --non-interactive $EXTRA_ZYPPER_OPTS update
}

update_apk() {
    run apk update
    run apk upgrade
}

# ---------------- reboot detection ----------------

check_reboot_needed() {
    # Returns 0 if a reboot is needed, 1 otherwise.

    # Debian/Ubuntu marker
    if [ -f /var/run/reboot-required ] || [ -f /run/reboot-required ]; then
        dbg "reboot marker file present"
        return 0
    fi

    # RHEL family via dnf-utils / yum-utils
    if command -v needs-restarting >/dev/null 2>&1; then
        if ! needs-restarting -r >/dev/null 2>&1; then
            dbg "needs-restarting -r reports reboot needed"
            return 0
        fi
    fi

    # SUSE
    if command -v zypper >/dev/null 2>&1; then
        if zypper ps -s 2>/dev/null | grep -q -i 'reboot'; then
            dbg "zypper ps -s suggests reboot"
            return 0
        fi
    fi

    # Kernel mismatch heuristic (works on most distros)
    _running="$(uname -r)"
    _installed=""
    if [ -d /boot ]; then
        _installed="$(ls -1 /boot/vmlinuz-* 2>/dev/null \
                      | sed 's|.*/vmlinuz-||' \
                      | sort -V \
                      | tail -n 1)"
    fi
    if [ -n "$_installed" ] && [ "$_installed" != "$_running" ]; then
        dbg "kernel mismatch: running=$_running installed=$_installed"
        return 0
    fi

    return 1
}

# ---------------- argv parsing ----------------

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --config)
                shift
                [ $# -gt 0 ] || die "--config requires PATH (or '-')"
                if [ "$1" = "-" ]; then
                    # print resolved config and exit
                    _c="$(resolve_config 2>/dev/null || true)"
                    if [ -n "$_c" ]; then
                        echo "$_c"
                        exit 0
                    else
                        echo "(no config file found)" >&2
                        exit 1
                    fi
                fi
                CONFIG="$1"
                ;;
            --create-config)
                shift
                if [ $# -eq 0 ] || [ "${1#-}" != "$1" ]; then
                    # no path arg, or next arg is another option
                    print_default_config
                    exit 0
                fi
                _path="$1"
                if [ -e "$_path" ]; then
                    die "refusing to overwrite existing file: $_path"
                fi
                print_default_config > "$_path"
                echo "wrote default config to: $_path" >&2
                exit 0
                ;;
            -D|--debug)
                DEBUG=1
                # Optional path argument (only if next token doesn't look like an option)
                if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then
                    shift
                    DEBUG_LOG="$1"
                fi
                ;;
            -n|--dry-run)
                DRY_RUN=1
                ;;
            -r|--reboot)
                REBOOT_AFTER=1
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -V|--version)
                echo "$SCRIPT_NAME $VERSION"
                exit 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                echo "unknown option: $1" >&2
                usage >&2
                exit 2
                ;;
            *)
                echo "unexpected argument: $1" >&2
                usage >&2
                exit 2
                ;;
        esac
        shift
    done
}

# ---------------- main ----------------

main() {
    parse_args "$@"
    load_config

    require_root

    log "===== $SCRIPT_NAME $VERSION starting ====="
    log "host:    $(hostname -f 2>/dev/null || hostname)"
    log "distro:  $(distro_id)"
    log "kernel:  $(uname -srvm)"
    log "uptime:  $(uptime 2>/dev/null | sed 's/^ *//;s/  */ /g')"
    log "dry-run: $DRY_RUN"

    _pm="$(detect_pkgmgr)" || die "no supported package manager found"
    log "pkgmgr:  $_pm"

    case "$_pm" in
        dnf)    update_dnf    ;;
        yum)    update_yum    ;;
        apt)    update_apt    ;;
        zypper) update_zypper ;;
        apk)    update_apk    ;;
        *)      die "unhandled package manager: $_pm" ;;
    esac

    if [ -n "$POST_UPDATE_HOOK" ] && [ -x "$POST_UPDATE_HOOK" ]; then
        log "running post-update hook: $POST_UPDATE_HOOK"
        run "$POST_UPDATE_HOOK" "$_pm"
    fi

    log "===== update complete ====="

    if check_reboot_needed; then
        log "REBOOT REQUIRED"
        if [ "$REBOOT_AFTER" = "1" ]; then
            log "rebooting in 10 seconds (--reboot was given)..."
            if [ "$DRY_RUN" = "0" ]; then
                sleep 10
                /sbin/shutdown -r +0 "$SCRIPT_NAME: rebooting after package update" &
            else
                log "(dry-run: skipped reboot)"
            fi
            exit 0
        else
            log "not rebooting (run with --reboot, or 'systemctl reboot' manually)"
            exit 10
        fi
    fi

    log "no reboot required"
    exit 0
}

main "$@"
